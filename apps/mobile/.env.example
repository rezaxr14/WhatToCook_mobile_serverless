# Public Expo values only. The Supabase anon/publishable key is safe to ship
# in the app bundle; AI provider keys and the service-role key must never
# appear here. They live in Supabase Edge Function secrets.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
