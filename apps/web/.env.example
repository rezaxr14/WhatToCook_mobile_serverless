# Web client environment. Copy to apps/web/.env.local and fill in.
# These values are public: they end up in the static bundle.
# Never put a service-role key or an AI provider key here.

# Local: http://127.0.0.1:54321 (printed by `pnpm supabase:start`).
# Staging: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Use the anon key or the new publishable key. Never the service-role key.
VITE_SUPABASE_ANON_KEY=

# local | staging | prod
VITE_APP_ENV=local
