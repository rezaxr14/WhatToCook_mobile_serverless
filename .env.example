# WhatToCook environment template
#
# Copy this file to .env.local for Supabase CLI / CI / server-side secrets:
#   macOS/Linux:  cp .env.example .env.local
#   PowerShell:   Copy-Item .env.example .env.local
#
# .env.local is gitignored. Never commit real values.
#
# The Supabase CLI does not auto-load the root .env.local. Load it first:
#   bash:       set -a; source .env.local; set +a
#   PowerShell: Get-Content .env.local | Where-Object { $_ -match '^\w+=' } |
#               ForEach-Object { $k, $v = $_ -split '=', 2; Set-Item "Env:$k" $v }
#
# Public client values are split out because Vite and Expo load env files from
# their own app directories:
#   Web:    copy the VITE_* block to apps/web/.env.local
#   Mobile: copy the EXPO_PUBLIC_* block to apps/mobile/.env.local (M2+)
#
# Vite only exposes VITE_* to the browser and Expo only exposes EXPO_PUBLIC_*.
# Never put a service-role key or an AI provider key in either prefix.

# ---------------------------------------------------------------------------
# Supabase CLI and GitHub Actions deploy (server-side only)
# ---------------------------------------------------------------------------
# Personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Project ref, not the project display name. Current staging: lderdvhteofqemiivosz.
SUPABASE_PROJECT_ID=
# Direct Postgres password for the project, used by `supabase link` and
# `supabase db push`. Rotating it invalidates old direct connections; update
# this file and the GitHub `staging` environment secret together.
SUPABASE_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Web client (Vite, build-time public values)
# Copy these three lines to apps/web/.env.local.
# ---------------------------------------------------------------------------
# Local: http://127.0.0.1:54321 (printed by `pnpm supabase:start`).
# Staging: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
# Use the anon key or the new publishable key. Never the service-role key.
VITE_SUPABASE_ANON_KEY=
# local | staging | prod
VITE_APP_ENV=local

# ---------------------------------------------------------------------------
# Mobile client (Expo, public values; added in M2)
# Copy these lines to apps/mobile/.env.local.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Edge Functions / AI provider (server-side only)
# Set these in Supabase, not in the client bundle:
#   pnpm exec supabase secrets set AI_PROVIDER=openrouter
#   pnpm exec supabase secrets set OPENROUTER_API_KEY=...
#   pnpm exec supabase secrets set OPENROUTER_MODEL=...
# ---------------------------------------------------------------------------
# fake for deterministic tests; gemini, openrouter, or lmstudio for a real provider.
AI_PROVIDER=fake
# Real Gemini key (server-side only). Add it here for local functions or with
# `pnpm exec supabase secrets set GEMINI_API_KEY=...` for staging/prod.
GEMINI_API_KEY=
# Optional override. Model routing normally comes from app_config / ai_model_prices.
# GEMINI_MODEL=
# Optional vision model override for pantry scans.
# GEMINI_VISION_MODEL=

# OpenRouter (server-side only). Set AI_PROVIDER=openrouter to use it.
# Create a key at https://openrouter.ai/keys and paste it below. Never expose
# this value through VITE_* or EXPO_PUBLIC_*.
OPENROUTER_API_KEY=
# Required when AI_PROVIDER=openrouter. Use the exact model id from
# https://openrouter.ai/models, for example: openai/gpt-4o-mini
OPENROUTER_MODEL=
# Optional comma-separated allowlist for client-selected models. When empty,
# the curated free OpenRouter catalog (`*:free` and `openrouter/free`) is
# selectable. Paid models are only selectable when listed here.
# OPENROUTER_ALLOWED_MODELS=
# Optional vision override; defaults to OPENROUTER_MODEL when the model supports images.
# OPENROUTER_VISION_MODEL=
# Optional comma-separated fallback model ids, all in the same OpenRouter namespace.
# OPENROUTER_FALLBACK_MODELS=
# OPENROUTER_VISION_FALLBACK_MODELS=
# OpenRouter request attribution headers (optional).
# OPENROUTER_SITE_URL=https://your-web-app.example
# OPENROUTER_APP_NAME=WhatToCook
# Some models reject response_format=json_object. Set false if your model errors.
# OPENROUTER_JSON_MODE=true
# OpenRouter pricing used for quota reservation/settlement, in micro-USD per 1M
# tokens. Defaults are conservative (USD 1 input / USD 3 output). Set them to
# the selected model's current prices for accurate metering.
# OPENROUTER_INPUT_MICRO_USD_PER_MILLION=1000000
# OPENROUTER_OUTPUT_MICRO_USD_PER_MILLION=3000000

# LM Studio (server-side only; local development). Set AI_PROVIDER=lmstudio to
# route free local requests through LM Studio's OpenAI-compatible server. Start
# the server with `lms server start`; models are billed at $0. Never expose
# LMSTUDIO_* through VITE_* or EXPO_PUBLIC_*.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Required when AI_PROVIDER=lmstudio. Use the exact id from `lms ls`.
LMSTUDIO_MODEL=
# Optional comma-separated allowlist for client-selected local models.
# LMSTUDIO_ALLOWED_MODELS=
# Optional vision override for pantry scans; defaults to LMSTUDIO_MODEL.
# LMSTUDIO_VISION_MODEL=
# Only needed if your LM Studio server requires an API key.
# LMSTUDIO_API_KEY=
# LM Studio rejects response_format=json_object for many local models, so JSON
# mode is off by default and structured calls rely on server-side validation.
# Set true only if your LM Studio build accepts json_object.
# LMSTUDIO_JSON_MODE=false
# Local models can be slower than hosted ones; defaults are 120s/180s.
# LMSTUDIO_TIMEOUT_MS=120000
# LMSTUDIO_STREAM_TIMEOUT_MS=180000

# Global provider request-rate guards. Blank disables a guard. These count
# actual provider attempts (not cache hits or idempotent replays). RPM is a
# rolling minute; RPD resets at UTC midnight. Set them to your provider's
# account limits, for example OpenRouter's free-tier RPM/RPD.
AI_RPM_LIMIT=
AI_RPD_LIMIT=

# Per-client request guards (provider calls per fixed one-minute window).
# Unset uses the built-in defaults (20 signed-in users, 8 anonymous accounts,
# 40 per hashed client IP). Set a value to override; set it to an empty value to
# disable that guard. The database window lives in public.ai_rate_windows.
# AI_USER_RPM_LIMIT=20
# AI_ANON_RPM_LIMIT=8
# AI_IP_RPM_LIMIT=40

# Comma-separated browser origins allowed to call the AI functions.
# Exact scheme/host/port, no trailing slash. Include hosted web origins.
# Example: http://localhost:5173,http://127.0.0.1:5173,https://your-web-app.example
# ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Optional local-only integrations
# ---------------------------------------------------------------------------
# Supabase Studio AI assistant only:
# OPENAI_API_KEY=
# SMS auth (not enabled):
# SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
# S3 protocol / analytics (not enabled):
# S3_HOST=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ---------------------------------------------------------------------------
# Reminder
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY is injected into Edge Functions by Supabase.
# Do not add it here, and never expose it through VITE_* or EXPO_PUBLIC_*.
