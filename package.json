{
  "name": "whattocook-serverless",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:web": "pnpm --filter @whattocook/web build",
    "dev:web": "pnpm --filter @whattocook/web dev",
    "dev:mobile": "pnpm --filter @whattocook/mobile start",
    "android": "pnpm --filter @whattocook/mobile android",
    "gen:types": "supabase gen types typescript --local --schema public > packages/shared/src/database.types.ts && prettier --write packages/shared/src/database.types.ts",
    "gen:types:remote": "supabase gen types typescript --project-id lderdvhteofqemiivosz --schema public > packages/shared/src/database.types.ts && prettier --write packages/shared/src/database.types.ts",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "supabase:test": "supabase test db"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.7.4",
    "supabase": "^2.121.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
