# Local Edge Functions environment (server-side only).
# Copy to supabase/functions/.env; `supabase functions serve` loads it by default.
# Never expose these values through VITE_* or EXPO_PUBLIC_*.

# fake for deterministic tests; gemini or openrouter for a real provider.
AI_PROVIDER=fake
GEMINI_API_KEY=

# Optional overrides. Model routing normally comes from app_config / ai_model_prices.
# Gemini uses Flash-Lite only: gemini-3.5-flash-lite as the default and
# gemini-3.1-flash-lite as the fallback.
# GEMINI_MODEL=
# GEMINI_VISION_MODEL=

# OpenRouter (server-side only). Set AI_PROVIDER=openrouter to use it as the
# primary provider, or AI_FALLBACK_PROVIDER=openrouter to retry failed Gemini
# text calls on it. Free ids (`openrouter/free`, `*:free`) are billed at $0.
OPENROUTER_API_KEY=
# Required when AI_PROVIDER=openrouter, and used by the Gemini fallback.
OPENROUTER_MODEL=openrouter/free
# Retry text/stream/chat calls on OpenRouter after the primary provider fails.
# AI_FALLBACK_PROVIDER=openrouter
# Also send pantry photos to the fallback provider (off by default).
# AI_FALLBACK_VISION=false
# Optional comma-separated allowlist for client-selected models. When empty,
# the curated free OpenRouter catalog (`*:free` and `openrouter/free`) is
# selectable. Paid models are only selectable when listed here.
# OPENROUTER_ALLOWED_MODELS=
# Optional; defaults to OPENROUTER_MODEL. Use a multimodal model for scans.
# OPENROUTER_VISION_MODEL=
# Optional comma-separated fallback model ids.
# OPENROUTER_FALLBACK_MODELS=
# OPENROUTER_VISION_FALLBACK_MODELS=
# Optional OpenRouter request attribution.
# OPENROUTER_SITE_URL=http://localhost:5173
# OPENROUTER_APP_NAME=WhatToCook
# Set false if the selected model rejects response_format=json_object.
# OPENROUTER_JSON_MODE=true
# Optional pricing override in micro-USD per 1M tokens. Defaults: 1000000 / 3000000.
# OPENROUTER_INPUT_MICRO_USD_PER_MILLION=
# OPENROUTER_OUTPUT_MICRO_USD_PER_MILLION=

# Global provider request-rate guards. Blank disables a guard. RPM is a rolling
# minute; RPD resets at UTC midnight. Set them to your provider's account limits.
AI_RPM_LIMIT=
AI_RPD_LIMIT=

# Per-client request guards (provider calls per fixed one-minute window).
# Unset uses the built-in defaults (20 signed-in users, 8 anonymous accounts,
# 40 per hashed client IP). Set a value to override; set it to an empty value to
# disable that guard. The database window lives in public.ai_rate_windows.
# AI_USER_RPM_LIMIT=20
# AI_ANON_RPM_LIMIT=8
# AI_IP_RPM_LIMIT=40

# Comma-separated browser origins allowed to call the AI functions.
# Exact scheme/host/port, no trailing slash.
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
