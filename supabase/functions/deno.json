{
  "importMap": "import_map.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any",
        "no-import-prefix",
        "no-control-regex",
        "require-await"
      ]
    }
  },
  "tasks": {
    "test": "deno test --allow-env --allow-net --allow-read",
    "check": "deno check generate-recipe/index.ts scan-pantry/index.ts suggest-substitution/index.ts ai-models/index.ts cache-ingredient-images/index.ts"
  }
}
